    "react-dom": "19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.3",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
