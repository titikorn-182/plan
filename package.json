  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"tests/**/*.{ts,mjs}\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"features/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx}\" \"tests/**/*.{ts,mjs}\" \"*.{ts,mjs}\"",
    "typecheck": "tsc --noEmit",
    "types:generate": "supabase gen types typescript --project-id noemwilgvrwpgqavtekm --schema public > types/database.generated.ts",
    "test:uat": "node --experimental-strip-types --test tests/*.test.mjs",
    "capture": "node scripts/capture-screenshot.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "2.115.0",
